<Window
  x:Class="ScannerTest.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ScannerTest"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="MainWindow"
  Width="800"
  Height="450"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel
      Grid.Row="0"
      Background="Beige"
      Orientation="Horizontal">
      <Button
        Height="30"
        Margin="5,0"
        Padding="10,0"
        Click="listButton_Click">
        List Scanners
      </Button>
      <ComboBox
        x:Name="devicesComboBox"
        MinWidth="200"
        Margin="5,0" />
      <Button
        Height="30"
        Margin="5,0"
        Padding="10,0"
        Click="scanButton_Click">
        Scan
      </Button>
    </StackPanel>

    <Border Grid.Row="1" Background="LightGray">
      <WrapPanel x:Name="imagePanel" />
    </Border>

  </Grid>
</Window>
